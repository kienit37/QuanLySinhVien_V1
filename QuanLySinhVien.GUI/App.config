<?xml version="1.0" encoding="utf-8"?>
<configuration>

	<!-- Cấu hình Logging -->
	<appSettings>
		<add key="EnableLogging" value="true" />
		<add key="LogLevel" value="Information" />
		<add key="LogRetentionDays" value="30" />
		<add key="SlowOperationThresholdMs" value="1000" />
	</appSettings>

	<!-- Kết nối SQL Server -->
	<connectionStrings>
		<add name="QuanLySinhVien"
             connectionString="Data Source=KIENIT\SQLEXPRESS01;Initial Catalog=QuanLySinhVien;Integrated Security=True;TrustServerCertificate=True"
             providerName="System.Data.SqlClient" />
	</connectionStrings>

</configuration>
